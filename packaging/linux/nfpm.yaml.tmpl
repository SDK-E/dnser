name: dnser-desktop
arch: ${ARM}
platform: linux
version: ${VERSION}
section: utils
priority: optional
maintainer: SDK Enterprises <hicham@sdk.enterprises>
description:
  Local DNS management for development
vendor: SDK Enterprises
homepage: https://github.com/SDK-E/dnser
license: BUSL-1.1
contents:
  - src: ${BIN_PATH}
    dst: /usr/bin/dnser-desktop
  - src: ${DESKTOP_FILE}
    dst: /usr/share/applications/dnser-desktop.desktop
  - src: ${ICON_256}
    dst: /usr/share/icons/hicolor/256x256/apps/dnser.png
  - src: ${ICON_512}
    dst: /usr/share/icons/hicolor/512x512/apps/dnser.png
depends:
  - libgtk-3-0
  - libwebkit2gtk-4.1-0
overrides:
  rpm:
    depends:
      - gtk3
      - webkit2gtk4.1
