{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://dnser.dev/schemas/dnser.config.schema.json",
  "title": "DNSer configuration (dnser.json)",
  "description": "Schema for ~/.dnser/dnser.json — DNSer daemon settings and linked projects.",
  "type": "object",
  "required": ["version", "settings", "projects"],
  "properties": {
    "version": { "type": "integer", "const": 2 },
    "settings": { "$ref": "#/$defs/settings" },
    "projects": { "type": "array", "items": { "$ref": "#/$defs/project" } }
  },
  "$defs": {
    "settings": {
      "type": "object",
      "required": ["tld", "bind", "upstreams", "autostart", "ports"],
      "properties": {
        "tld": { "type": "string", "description": "Development TLD served by the resolver, e.g. \"test\"." },
        "bind": { "type": "string", "format": "ipv4" },
        "upstreams": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string" },
          "description": "Upstream resolvers for forwarded queries."
        },
        "autostart": { "type": "boolean" },
        "force_https": {
          "type": "boolean",
          "default": false,
          "description": "Global default: redirect plain HTTP to HTTPS for every HTTPS-enabled route."
        },
        "path_refresh_minutes": {
          "type": "integer",
          "minimum": 0,
          "maximum": 525600,
          "default": 1440,
          "description": "TTL for the cached login-shell PATH used by managed dev servers. 0 = default (24h)."
        },
        "ports": {
          "type": "object",
          "required": ["dns", "http", "https", "ui"],
          "properties": {
            "dns": { "type": "integer", "minimum": 1, "maximum": 65535 },
            "http": { "type": "integer", "minimum": 1, "maximum": 65535 },
            "https": { "type": "integer", "minimum": 1, "maximum": 65535 },
            "ui": { "type": "integer", "minimum": 1, "maximum": 65535 }
          }
        }
      }
    },
    "project": {
      "type": "object",
      "required": ["domain", "created_at", "updated_at"],
      "properties": {
        "domain": { "type": "string", "description": "Project zone, FQDN-style without trailing dot (myproject.test)." },
        "path": { "type": "string" },
        "run": { "$ref": "#/$defs/run" },
        "services": {
          "type": "array",
          "items": { "$ref": "#/$defs/service" },
          "description": "Named services: supervised processes or external endpoints of any type."
        },
        "routes": {
          "type": "array",
          "items": { "$ref": "#/$defs/route" }
        },
        "records": {
          "type": "array",
          "items": { "$ref": "#/$defs/record" }
        },
        "created_at": { "type": "string", "format": "date-time" },
        "updated_at": { "type": "string", "format": "date-time" }
      }
    },
    "run": {
      "type": "object",
      "properties": {
        "command": {
          "type": "string",
          "description": "Primary dev-server command. Supports {port} and {port:<service>} placeholders. Executed via /bin/sh -c with an augmented PATH."
        },
        "mode": { "enum": ["", "dev"] },
        "port": { "type": "integer", "minimum": 0, "maximum": 65535 }
      }
    },
    "service": {
      "type": "object",
      "required": ["name"],
      "allOf": [
        {
          "if": { "properties": { "command": { "type": "string", "minLength": 1 } }, "required": ["command"] },
          "then": { "properties": { "host": { "maxLength": 0 } } }
        }
      ],
      "properties": {
        "name": { "$ref": "#/$defs/label" },
        "type": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9._-]*$|^$",
          "description": "Free-form service label (redis, postgres, smtp, http, ...)."
        },
        "command": {
          "type": "string",
          "description": "Managed process command; mutually exclusive with host."
        },
        "host": {
          "type": "string",
          "description": "External endpoint host; requires port."
        },
        "port": {
          "type": "integer",
          "minimum": 0,
          "maximum": 65535,
          "description": "Managed: locally allocated port the process binds (0 = auto). External: remote port."
        },
        "transport": { "enum": ["", "tcp", "udp"] },
        "dns": {
          "type": "boolean",
          "default": false,
          "description": "Publish <name>.<domain> in DNS (A for IPs/managed, CNAME for hostnames)."
        }
      }
    },
    "route": {
      "type": "object",
      "required": ["host", "backends"],
      "oneOf": [
        {
          "properties": { "tcp": { "const": true }, "udp": { "const": false }, "listen": { "type": "integer", "minimum": 1, "maximum": 65535 } },
          "required": ["listen"]
        },
        {
          "properties": { "udp": { "const": true }, "tcp": { "const": false }, "listen": { "type": "integer", "minimum": 1, "maximum": 65535 } },
          "required": ["listen"]
        },
        { "properties": { "tcp": { "const": false }, "udp": { "const": false } } }
      ],
      "properties": {
        "host": {
          "$ref": "#/$defs/label",
          "description": "@ = zone apex, * = wildcard, relative label, or absolute host under the TLD."
        },
        "backends": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "pattern": "^[^:]+:(\\d+|\\{port(?::[A-Za-z0-9_-]+)?\\})$",
            "description": "host:port endpoint. Port may be {port} or {port:<service>} placeholder resolved at reconcile time."
          }
        },
        "tcp": {
          "type": "boolean",
          "description": "Raw TCP forwarding; requires listen."
        },
        "udp": {
          "type": "boolean",
          "description": "UDP relay; requires listen."
        },
        "listen": {
          "type": "integer",
          "minimum": 1,
          "maximum": 65535,
          "description": "Local frontend port for tcp/udp routes."
        },
        "https": { "type": "boolean" },
        "force_https": {
          "type": "boolean",
          "description": "Redirect plain HTTP to HTTPS; requires https."
        },
        "paths": {
          "type": "array",
          "items": { "type": "string", "pattern": "^/" },
          "description": "HTTP path prefixes routed here; longest prefix wins, unmatched paths fall back to the route without paths."
        }
      }
    },
    "record": {
      "type": "object",
      "required": ["type", "name", "value"],
      "properties": {
        "type": { "enum": ["A", "AAAA", "CNAME", "TXT", "MX", "SRV"] },
        "name": { "$ref": "#/$defs/label" },
        "value": { "type": "string" },
        "ttl": { "type": "integer", "minimum": 1 },
        "priority": { "type": "integer", "minimum": 0, "maximum": 65535 },
        "weight": { "type": "integer", "minimum": 0, "maximum": 65535 },
        "port": { "type": "integer", "minimum": 0, "maximum": 65535 }
      }
    },
    "label": {
      "type": "string",
      "pattern": "^(@|\\*|[a-z0-9]([a-z0-9-]*[a-z0-9])?(\\.[a-z0-9]([a-z0-9-]*[a-z0-9])?)*)$"
    }
  }
}
