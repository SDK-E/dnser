{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/SDK-E/dnser/internal/config/manifest",
  "$defs": {
    "Duration": {
      "type": "string",
      "pattern": "^[0-9]+(\\.[0-9]+)?(ns|us|µs|ms|s|m|h)+$",
      "description": "Go duration string, e.g. 30m or 2m"
    },
    "Forward": {
      "properties": {
        "proto": {
          "type": "string"
        },
        "listen": {
          "type": "integer"
        },
        "to": {
          "type": "integer"
        }
      },
      "additionalProperties": false,
      "type": "object"
    },
    "HTTPSSetting": {
      "oneOf": [
        {
          "type": "boolean"
        },
        {
          "additionalProperties": {
            "type": "boolean"
          },
          "propertyNames": {
            "type": "string"
          },
          "type": "object"
        }
      ]
    },
    "RawMap": {
      "type": "object"
    },
    "Record": {
      "properties": {
        "name": {
          "type": "string"
        },
        "type": {
          "type": "string"
        },
        "value": {
          "type": "string"
        }
      },
      "additionalProperties": false,
      "type": "object"
    },
    "Route": {
      "properties": {
        "path": {
          "type": "string"
        },
        "host": {
          "type": "string"
        },
        "port": {
          "type": "integer"
        },
        "backend": {
          "type": "string"
        }
      },
      "additionalProperties": false,
      "type": "object"
    },
    "Service": {
      "properties": {
        "image_hint": {
          "type": "string"
        },
        "type": {
          "type": "string"
        },
        "command": {
          "type": "string"
        },
        "readiness": {
          "type": "string"
        },
        "host": {
          "type": "string"
        },
        "port": {
          "type": "integer"
        },
        "dns": {
          "type": "boolean"
        }
      },
      "additionalProperties": false,
      "type": "object"
    },
    "Shell": {
      "oneOf": [
        {
          "type": "boolean"
        },
        {
          "type": "string",
          "minLength": 1
        }
      ]
    },
    "StringList": {
      "items": {
        "type": "string"
      },
      "type": "array"
    }
  },
  "properties": {
    "type": {
      "type": "string"
    },
    "domain": {
      "type": "string"
    },
    "domains": {
      "items": {
        "type": "string"
      },
      "type": "array"
    },
    "aliases": {
      "items": {
        "type": "string"
      },
      "type": "array"
    },
    "port": {
      "type": "integer"
    },
    "command": {
      "type": "string"
    },
    "shell": {
      "$ref": "#/$defs/Shell"
    },
    "cwd": {
      "type": "string"
    },
    "https": {
      "$ref": "#/$defs/HTTPSSetting"
    },
    "force_https": {
      "type": "boolean"
    },
    "env": {
      "additionalProperties": {
        "type": "string"
      },
      "type": "object"
    },
    "env_file": {
      "$ref": "#/$defs/StringList"
    },
    "services": {
      "additionalProperties": {
        "$ref": "#/$defs/Service"
      },
      "type": "object"
    },
    "routes": {
      "items": {
        "$ref": "#/$defs/Route"
      },
      "type": "array"
    },
    "records": {
      "items": {
        "$ref": "#/$defs/Record"
      },
      "type": "array"
    },
    "forward": {
      "items": {
        "$ref": "#/$defs/Forward"
      },
      "type": "array"
    },
    "process": {
      "$ref": "#/$defs/RawMap"
    },
    "caddy": {
      "$ref": "#/$defs/RawMap"
    },
    "availability": {
      "type": "string"
    },
    "idle_stop": {
      "$ref": "#/$defs/Duration"
    },
    "min_uptime": {
      "$ref": "#/$defs/Duration"
    }
  },
  "additionalProperties": false,
  "type": "object"
}
