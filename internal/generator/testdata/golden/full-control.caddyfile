# generated by dnser; edits are overwritten

admin.app.acme.io {
	tls internal
	reverse_proxy 127.0.0.1:4001
	handle_errors {
		respond <<HTML
		<!DOCTYPE html><html><head><title>dnser</title></head><body style="background:#082003;color:#2cdb16;font-family:system-ui;display:flex;align-items:center;justify-content:center;height:100vh;margin:0"><div style="text-align:center"><h1 style="font-size:3rem;margin:0">Zzz</h1><p>This project is asleep or restarting. The first request wakes it up.</p></div></body></html>
		HTML 503
	}
}

app.acme.io {
	tls internal
	reverse_proxy 127.0.0.1:3000
	@denied {
		path /private/*
	}
	abort @denied
	encode gzip
	@dnser_route_0 {
		path /assets/*
	}
	handle @dnser_route_0 {
			root apps/web/public
	}
	header {
		+X-Frame-Options DENY
		+X-Powered-By dnser
	}
	log {
		output file /home/dev/.dnser/logs/auth/access.log
	}
	handle_errors {
		respond <<HTML
		<!DOCTYPE html><html><head><title>dnser</title></head><body style="background:#082003;color:#2cdb16;font-family:system-ui;display:flex;align-items:center;justify-content:center;height:100vh;margin:0"><div style="text-align:center"><h1 style="font-size:3rem;margin:0">Zzz</h1><p>This project is asleep or restarting. The first request wakes it up.</p></div></body></html>
		HTML 503
	}
}
